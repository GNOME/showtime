{
  "id": "org.gnome.Showtime.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "master",
  "sdk": "org.gnome.Sdk",
  "command": "showtime",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--talk-name=org.gtk.vfs.*",
    "--filesystem=xdg-run/gvfsd"
  ],
  "modules": [
    {
      "name": "gst-python",
      "buildsystem": "meson",
      "subdir": "subprojects/gst-python",
      "config-opts": [
        "-Dpygi-overrides-dir=/app/lib/python3.14/site-packages/gi/overrides/"
      ],
      "sources": [
        {
          "type": "git",
          "disable-submodules": true,
          "url": "https://gitlab.freedesktop.org/gstreamer/gstreamer.git",
          "commit": "2d3e05cbdad68e47d645f548899b432dc9fb4473",
          "tag": "1.28.6"
        }
      ]
    },
    {
      "name": "showtime",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": ["-Dprofile=development"],
      "sources": [
        {
          "type": "dir",
          "path": "../../"
        }
      ]
    }
  ]
}
